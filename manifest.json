{
  "manifest_version": 3,
  "name": "Dual Subtitles – Two Languages at Once",
  "version": "0.1.0",
  "description": "See two subtitle languages at the same time while watching Netflix. Great for language learning and bilingual viewing.",
  "host_permissions": ["*://*.netflix.com/*", "*://*.nflxvideo.net/*"],
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["src/inject/manifest-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": [
        "src/shared/messages.js",
        "src/content/site-adapters/types.js",
        "src/content/site-adapters/netflix.js",
        "src/content/subtitle/parser.js",
        "src/content/renderer.js",
        "src/content/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Dual Subtitles",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
